; Engine configuration file.
; It's best edited using the editor UI and not directly.

config_version=5

[application]

config/name="Duskrail"
config/description="Duskrail - 3D railway simulation with an open world, detailed locomotives and freight missions"
config/version="alpha1.10"
run/main_scene="res://src/boot/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.030, 0.033, 0.040, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

[physics]

common/physics_interpolation=true

[rendering]

textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
